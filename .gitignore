# Secrets — the principal fills .env themselves; it must never be committed.
.env

# Local state (SQLite DB, generated briefings/audio) — user data, not code.
data/
audio/

# Principal-editable memory surface (milestone 4) — personal state, not code.
memory.md

# Stage-0 M1: every non-default profile's whole world (its own DB, corpus,
# artifacts, spend log, memory.md and sources.yaml). Reader state, not code —
# and a tester's reading is the most private state this repo can hold. The
# committed thing a profile is BORN from is templates/profile-sources.yaml.
profiles/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# macOS
.DS_Store
preview_runtime/
