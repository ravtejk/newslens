#!/usr/bin/env python3
"""NewsLens moat Phase-2 battery launcher (NL-75 T1/T2/T3).

Thin on purpose (the scripts/battery + scripts/doctor pattern): bootstraps
sys.path so the runner works from a fresh checkout, then delegates to
src/newslens/moat_battery.py. All logic lives there and is offline-testable.

    scripts/moat-battery plan                    # whole-session cost, $0
    scripts/moat-battery t1                      # DRY RUN: retro-pair plan
    scripts/moat-battery t2                      # DRY RUN: ablation 2x2 plan
    scripts/moat-battery t3 --run                # Concept B pack ($0, no LLM)
    scripts/moat-battery t1 --run                # LIVE writer calls
    scripts/moat-battery pack --run              # seal the blind pack

Dry-run is the default everywhere and makes ZERO calls and ZERO writes. --run
executes; the api lane needs ANTHROPIC_API_KEY, the total is bounded by
BUDGET_CAP_USD_PER_RUN (CHARGED dollars, per invocation), and the briefing of
record is NEVER touched — artifacts land under <DATA_DIR>/battery/<session>/
phase2/.
"""

import sys
from pathlib import Path

PROTOTYPE_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROTOTYPE_ROOT / "src"))

from newslens.moat_battery import main  # noqa: E402  (path bootstrap first)

if __name__ == "__main__":
    sys.exit(main())
