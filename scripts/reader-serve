#!/usr/bin/env python3
"""NewsLens reader launcher — serve any profile at $0, on a probed free port.

Thin on purpose (scripts/persona-serve's pattern): bootstraps sys.path so it
runs from a fresh clone, then hands off to newslens.readerserve. All logic
lives in src/newslens/readerserve.py, where the suite can reach it.

    scripts/reader-serve fresh1              # $0 by default
    scripts/reader-serve --create fresh2     # mint the world and serve it
    scripts/reader-serve fresh1 --live       # opt in to metered Sonar
"""

import sys
from pathlib import Path

PROTOTYPE_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROTOTYPE_ROOT / "src"))

from newslens.readerserve import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
